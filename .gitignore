!docs/images/*

# ---- Logs & temp ----
*.log
tmp/
temp/

# ---- IDEs / editors ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

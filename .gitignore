# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Secrets / local config ----
.env
.env.*
*.local

